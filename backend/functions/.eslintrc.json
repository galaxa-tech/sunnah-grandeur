{
  "env": {
    "es2020": true,
    "node": true
  },
  "extends": ["eslint:recommended", "google"],
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "commonjs"
  },
  "rules": {
    "no-restricted-globals": ["error", "name", "length"],
    "prefer-arrow-callback": "error",
    "quotes": ["error", "double", { "avoidEscape": true }],
    "indent": ["error", 2],
    "max-len": ["warn", { "code": 120 }],
    "require-jsdoc": "off",
    "valid-jsdoc": "off",
    "no-unused-vars": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.spec.*"],
      "env": {
        "mocha": true
      },
      "rules": {}
    }
  ],
  "globals": {}
}
