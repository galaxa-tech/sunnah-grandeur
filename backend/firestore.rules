rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Accepts both "admin" and "superAdmin" roles
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == "admin" ||
        request.auth.token.role == "superAdmin"
      );
    }

    // Prevents a user from updating protected fields via client SDK.
    function notTouchingProtectedFields() {
      let protected = ["role", "uid", "createdAt"];
      return !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(protected);
    }

    // ── /users/{uid} ──────────────────────────────────────────────────────────
    match /users/{uid} {
      // Owner reads own profile; admin reads any profile.
      allow read: if isOwner(uid) || isAdmin();

      // Creation is Cloud Function only — createUserMetadata sets role:'user'.
      allow create: if false;

      // Owner can update their own profile but cannot touch protected fields.
      allow update: if (isOwner(uid) && notTouchingProtectedFields()) || isAdmin();

      // Deletion is Cloud Function only.
      allow delete: if false;

      // Tasbih sessions are private to the owner.
      match /tasbih_sessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── /products/{productId} ─────────────────────────────────────────────────
    match /products/{productId} {
      // Public read for active products. Admins see all.
      allow read: if resource == null || resource.data.isActive == true || isAdmin();

      // Admin panel writes products directly via client SDK
      allow write: if isAdmin();
    }

    // ── /orders/{orderId} ────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Owner reads own orders; admin reads any order.
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid || isAdmin());

      // Admin can update order status (fulfillment). Customers cannot write orders directly.
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── /media/{mediaId} ─────────────────────────────────────────────────────
    match /media/{mediaId} {
      allow read:  if resource == null || resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // ── /hadiths/{hadithId} ───────────────────────────────────────────────────
    match /hadiths/{hadithId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── /settings/{docId} ────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read:  if true;         // app_config is intentionally public
      allow write: if isAdmin();
    }

    // ── /masjids/{masjidId} ──────────────────────────────────────────────────
    match /masjids/{masjidId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── /config/{docId} ──────────────────────────────────────────────────────
    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    // ── /contactMessages/{docId} ──────────────────────────────────────────────
    match /contactMessages/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── /categories/{categoryId} ─────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── /banners/{bannerId} ──────────────────────────────────────────────────
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── /favorites/{userId} ──────────────────────────────────────────────────
    match /favorites/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      match /items/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ── Catch-all deny ────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
