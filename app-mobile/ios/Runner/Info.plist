<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<!-- ── App Transport Security ──────────────────────────────────────── -->
		<!-- Scoped to only the hosts that actually need cleartext/legacy TLS  -->
		<!-- exceptions (YouTube embeds + the API domains this app calls) —    -->
		<!-- replaces a blanket NSAllowsArbitraryLoads, which App Review flags. -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSExceptionDomains</key>
			<dict>
				<key>youtube.com</key>
				<dict>
					<key>NSIncludesSubdomains</key>
					<true/>
					<key>NSExceptionAllowsInsecureHTTPLoads</key>
					<false/>
				</dict>
				<key>ytimg.com</key>
				<dict>
					<key>NSIncludesSubdomains</key>
					<true/>
					<key>NSExceptionAllowsInsecureHTTPLoads</key>
					<false/>
				</dict>
				<key>googlevideo.com</key>
				<dict>
					<key>NSIncludesSubdomains</key>
					<true/>
					<key>NSExceptionAllowsInsecureHTTPLoads</key>
					<false/>
				</dict>
			</dict>
		</dict>
		<!-- ── Export compliance ────────────────────────────────────────────── -->
		<!-- No proprietary/custom encryption beyond standard HTTPS/TLS — lets -->
		<!-- App Store Connect skip the export-compliance prompt on every build. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<!-- ── URL schemes ────────────────────────────────────────────────── -->
		<key>CFBundleURLTypes</key>
		<array>
			<!-- Google Sign-In: REVERSED_CLIENT_ID from GoogleService-Info.plist -->
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.6748865044-i5lbfm7rf493b19u2f3b3k5n7f6mi6pp</string>
				</array>
			</dict>
			<!-- Stripe 3DS: flutter_stripe uses this scheme to redirect back from -->
			<!-- bank authentication pages after 3D Secure verification.           -->
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.sunnahgrandeur.app</string>
				</array>
			</dict>
		</array>
		<!-- ── Background modes ────────────────────────────────────────────── -->
		<!-- audio:              Adhan audio continues when screen locks         -->
		<!-- fetch:              Background fetch for prayer time updates        -->
		<!-- remote-notification: Silent push notifications                      -->
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
			<string>fetch</string>
			<string>remote-notification</string>
		</array>
		<!-- ── Location usage descriptions ────────────────────────────────── -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Sunnah Grandeur uses your location to calculate accurate prayer times.</string>
		<key>NSLocationAlwaysUsageDescription</key>
		<string>Sunnah Grandeur uses your location to calculate accurate prayer times.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>Sunnah Grandeur uses your location to calculate accurate prayer times.</string>
		<!-- ── Camera / microphone usage descriptions (Apple error 90683) ──── -->
		<!-- The app has no camera/mic feature of its own. youtube_player_flutter -->
		<!-- (used for embedded lecture/nasheed videos) pulls in flutter_inappwebview, -->
		<!-- whose WKWebView implements WKUIDelegate's media-capture permission -->
		<!-- callback so that web content *could* request camera/mic — Apple's -->
		<!-- binary scan flags that capability regardless of whether any page -->
		<!-- actually calls it. There's no supported flag to strip it from the -->
		<!-- plugin, so these strings are required for App Store validation. -->
		<key>NSCameraUsageDescription</key>
		<string>Camera access may be requested by interactive elements within embedded video content in the app.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Microphone access may be requested by interactive elements within embedded video content in the app.</string>
		<!-- ── url_launcher: allow opening Google Maps app ─────────────────── -->
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>comgooglemaps</string>
			<string>googlemaps</string>
		</array>
		<!-- ── Notification usage ──────────────────────────────────────────── -->
		<!-- iOS will prompt the user at runtime via requestPermissions() -->
		<!-- ── Google Maps iOS SDK key ────────────────────────────────────── -->
		<!-- $(MAPS_IOS_KEY) is resolved at build time from ApiKeys.xcconfig.  -->
		<!-- AppDelegate.swift reads this via Bundle.main at runtime.          -->
		<!-- The raw key string NEVER appears in source control.               -->
		<key>GMS_API_KEY</key>
		<string>$(MAPS_IOS_KEY)</string>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Sunnah Grandeur</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>sunnah_grandeur</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
	</dict>
</plist>
